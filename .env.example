# ---- Discord ----
# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Your own Discord user ID (Settings -> Advanced -> Developer Mode ON,
# then right-click your name -> Copy User ID). Comma-separate for more than one.
# NOBODY else can command the agent.
DISCORD_ALLOWED_USER_IDS=

# ---- Claude brain ----
# BRAIN=subscription  -> run on your Claude Code login, NO per-token API cost (recommended)
# BRAIN=api           -> use the ANTHROPIC_API_KEY below
# BRAIN=auto          -> subscription if no API key is set, else API
BRAIN=subscription

# Only needed if BRAIN=api. Leave blank to run on your subscription.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# Subscription mode model. 'opus' = best quality. Blank = your Claude Code default.
SUBSCRIPTION_MODEL=opus

# ---- Your assistant ----
# Her name - call her this when you talk to her. Change it to whatever you like.
AGENT_NAME=Zara

# ---- Voice ----
# Voice replies:  auto = speak only when YOU send a voice note (recommended)
#                 always = speak every reply
#                 never = text only
VOICE_REPLIES=auto
# FAST speech recognition (recommended): free key from https://console.groq.com -> API Keys
# ~1-2 seconds instead of ~13, and whisper-large-v3 understands Urdu far better than
# anything this laptop can run locally. Leave blank to stay fully offline.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# Local fallback model, used only when GROQ_API_KEY is blank or the internet is down.
# tiny / base / small / medium (bigger = better Urdu, much slower on this CPU)
WHISPER_MODEL=base
# Female voices (edge-tts). English options: en-US-JennyNeural, en-US-AriaNeural, en-GB-SoniaNeural
VOICE_ENGLISH=en-US-JennyNeural
# Urdu female voice: ur-PK-UzmaNeural
VOICE_URDU=ur-PK-UzmaNeural

# ---- Behaviour ----
# false = full autonomy, risky actions run instantly (what you asked for)
# true  = risky actions (delete, shutdown, registry, format...) ask you first
CONFIRM_RISKY=false

# How many tool steps the agent may take for one instruction
MAX_ITERATIONS=400

# If the step limit is still reached, carry on this many more times automatically
AUTO_CONTINUE=3

# Show a line in Discord for every tool call (noisy + slow). true only for debugging.
SHOW_TOOL_CALLS=false

# Seconds before a shell command is killed
SHELL_TIMEOUT=180

# How many past messages to remember per chat
HISTORY_TURNS=30

# Browser tool (Playwright): true = Chromium runs invisibly (recommended).
# false = show the browser window while it works. Needs a one-time
# `playwright install chromium` after installing requirements.
BROWSER_HEADLESS=true

# ---- Realistic emotional voice (ElevenLabs) ----
# Free key: https://elevenlabs.io -> Profile -> API Keys  (~10 min/month free, $6/mo Starter)
# Blank = free Microsoft voices (current). Easiest way to set it: SET_VOICE_KEY.bat
ELEVENLABS_API_KEY=
# eleven_v3 is the ONLY model that speaks Urdu AND performs emotion tags like [sighs]
ELEVENLABS_MODEL=eleven_v3
# Voice IDs - see them with: .venv\Scripts\python.exe list_voices.py
ELEVENLABS_VOICE_EN=9BWtsMINqrJLrRacOk9x
ELEVENLABS_VOICE_UR=
# Lower stability = more emotional range (0.3 expressive, 0.5 natural, 0.8 flat)
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.75

# ---- API providers (only when BRAIN=api) ----
# Which provider the API brain uses: anthropic | openai | gemini | deepseek | custom
API_PROVIDER=anthropic
# Model name for the provider (blank = provider default; for anthropic, AGENT_MODEL above is used)
PROVIDER_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Custom = ANY OpenAI-compatible endpoint (OpenRouter, Groq, Mistral, xAI, Together,
# or a local Ollama / LM Studio server). Set base + model; key may be blank for local servers.
CUSTOM_API_BASE=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# ---- Identity ----
# Product name (shown in the app/startup) and the assistant's own name.
# Rename the assistant to whatever you like - she answers to it.
PRODUCT_NAME=CodeHubb Assistant
ASSISTANT_NAME=Zara

# ---- Transports (Phase 1) ----
# Which front ends are switched on, comma-separated: discord, telegram, whatsapp.
# They can run at the same time and all share one brain. Leave as-is for the
# classic Discord-only setup.
TRANSPORTS=discord

# ---- Telegram ----
# Create a bot with @BotFather on Telegram (/newbot) and paste its token here.
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user ID (message @userinfobot to learn it).
# Comma-separate for more than one. NOBODY else can command the agent.
TELEGRAM_ALLOWED_USER_IDS=

# ---- WhatsApp (Route A - unofficial bridge) ----
# No token: pairing is by QR scan (WhatsApp -> Settings -> Linked devices),
# done once; the QR appears in the console and in .runtime/whatsapp/qr.txt.
# Requires Node.js 18+ and a one-time `npm install` inside the sidecar/ folder.
#
# WARNING: this route uses an unofficial WhatsApp Web bridge and can get the
# linked number restricted by WhatsApp. Use a DEDICATED secondary number -
# never your main or business number.
#
# Your own number in international format, digits only (e.g. 923001234567).
# Comma-separate for more than one. NOBODY else can command the agent.
WHATSAPP_ALLOWED_NUMBERS=
# Local bridge port between the Python agent and the sidecar (localhost only).
WA_BRIDGE_PORT=17331

# ---- Licensing (Phase 4, release builds) ----
# Leave LICENSE_PUBLIC_KEY blank for a development build: licensing is then
# disabled entirely and no key is needed. The RELEASE build ships with the
# seller's Ed25519 public key here, which turns on the 14-day trial and
# activation. (A public key is not a secret.)
LICENSE_PUBLIC_KEY=
# Optional activation server (see license_server/README.md). Blank = fully
# offline licensing: signed keys + 7-day grace rules only.
LICENSE_SERVER_URL=
